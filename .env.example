# ── LLM Providers ─────────────────────────────────────────────────────────────
# At least one is required. Both can coexist.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console.
# NEVER commit this file. It is already in .gitignore.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Where the OAuth token is saved after first login. Also gitignored.
GOOGLE_TOKEN_FILE=token.json

# ── RAG / Vector Store ─────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=text-embedding-3-small

# ── Agent Behaviour ────────────────────────────────────────────────────────────
# Model used for email classification (cheap, fast)
CLASSIFICATION_MODEL=gpt-4o-mini
# Model used for draft generation (more capable)
DRAFT_MODEL=gpt-4o
# Minimum confidence to auto-proceed without human classification review (0.0–1.0)
CONFIDENCE_THRESHOLD=0.75

# ── Inbox Watcher ──────────────────────────────────────────────────────────────
# How often to check for new emails (seconds)
POLL_INTERVAL_SECONDS=60
