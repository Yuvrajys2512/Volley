# ── LLM — Groq (free tier) ─────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ── RAG ────────────────────────────────────────────────────────────────────────
# Embeddings run locally via sentence-transformers — no API key needed.
CHROMA_DB_PATH=./chroma_db

# ── Agent Behaviour ────────────────────────────────────────────────────────────
CLASSIFICATION_MODEL=llama-3.1-8b-instant
DRAFT_MODEL=llama-3.3-70b-versatile
CONFIDENCE_THRESHOLD=0.75

# ── Inbox Watcher ──────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60

# ── Phase 1 — multi-tenant server (web + worker) ───────────────────────────────
# Local Postgres+pgvector, e.g. via `docker compose up`.
DATABASE_URL=postgresql+psycopg://volley:volley@localhost:5433/volley
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# Web-application-type OAuth client (separate registration from the CLI's
# Desktop-app client above) — Google Cloud Console → Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

WORKER_POLL_INTERVAL_SECONDS=90
MAX_RUNS_PER_DAY_PER_USER=200
